# Copia este archivo a .env.docker y completa los valores reales:
#   cp .env.docker.example .env.docker
#
# Levantar el stack (desde kinalsports-stack/):
#   ./scripts/bootstrap.sh              # clona repos (primera vez)
#   ./scripts/link-local.sh             # o enlaces si los repos estan al mismo nivel
#   docker compose --env-file .env.docker up --build

# --- BASE DE DATOS PG ---
POSTGRES_USER=gastreat_db
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=gastreat
POSTGRES_PORT=5438

# --- BASE DE DATOS MONGO ---
MONGODB_PORT=27021
MONGO_DB_NAME=GastreatGT

# --- PUERTOS EN USO DE SERVICIOS ---
AUTH_SERVICE_PORT=5198
AUTH_NODE_PORT=3026
SERVER_ADMIN_PORT=3022
SERVER_USER_PORT=3024
CLIENT_ADMIN_PORT=5174
CLIENT_USER_METRO_PORT=8081
CLIENT_USER_EXPO_PORT=19000
CLIENT_USER_EXPO_DEVTOOLS_PORT=19001
CLIENT_USER_EXPO_INSPECTOR_PORT=19002

# --- CONFIGURACIONES JWT (deben coincidir en todos los servicios) ---
JWT_SECRET=change-me-jwt-secret-min-256-bits
JWT_ISSUER=GastreatGT
JWT_AUDIENCE=GastreatGT

# --- CONFIGURACIONES FRONTEND URLS (acceso desde el host) ---
FRONTEND_URL=http://localhost:5174
VITE_AUTH_URL=http://localhost:5198/api/v1
VITE_ADMIN_URL=http://localhost:3022/gastreatGT/Admin/v1
VITE_CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/
# Expo: 10.0.2.2 = emulador Android; usa IP LAN para dispositivo fisico
EEXPO_PUBLIC_AUTH_URL=http://10.0.2.2:5198/api/v1/auth
EXPO_PUBLIC_API_URL=http://10.0.2.2:3022/gastreatGT/Admin/v1
EXPO_PUBLIC_USER_URL=http://10.0.2.2:3024/gastreatGT/User/v1
EXPO_PACKAGER_HOSTNAME=10.0.2.2

# --- URLS INTERNAS DOCKER (comunicacion entre contenedores) ---
AUTH_SERVICE_URL=http://auth-service:5198/api/v1
AUTH_NODE_URL=http://auth-node:3026/api/v1
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --- CLOUDINARY ---
# CLOUDINARY_FOLDER: perfiles auth (auth-node / auth-service)
# CLOUDINARY_TEAMS_FOLDER: logos de equipos (server-user / server-admin)
# Para campos/torneos en server-admin, el codigo usa CLOUDINARY_FOLDER o defaults kinal_sports/fields
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/
CLOUDINARY_FOLDER=auth_service/profiles
CLOUDINARY_DEFAULT_AVATAR_FILENAME=avatar-default.png
CLOUDINARY_DEFAULT_AVATAR_PATH=auth_service/profiles/avatar-default.png

# --- SMTP (auth-node y auth-service) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=467
SMTP_ENABLE_SSL=true
SMTP_USE_IMPLICIT_SSL=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=Gastreat GT Support
