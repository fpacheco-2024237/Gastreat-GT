# Server Admin environment example

PORT=3022

# MongoDB
URI_MONGODB=mongodb://localhost:27017/gastreat_gt

# CORS - origin allowed for the admin panel
ADMIN_ALLOWED_ORIGINS=http://localhost:5174

# Integracion con auth-service
AUTH_SERVICE_URL=http://localhost:5198/api/v1

# Token interno para comunicacion con server-user
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_BASE_URL=https://res.cloudinary.com/your-cloud-name/image/upload/
CLOUDINARY_FOLDER=gastreat_gt/menu
CLOUDINARY_DEFAULT_AVATAR_NAME=avatarForDefault.png

# JWT (debe coincidir con Auth Service .NET)
JWT_SECRET=GastreatGTImportSecretKeyNullGet
JWT_EXPIRES_IN=2h
JWT_ISSUER=GastreatGT
JWT_AUDIENCE=GastreatGT

# Misc
NODE_TLS_REJECT_UNAUTHORIZED=0
NODE_ENV=development
